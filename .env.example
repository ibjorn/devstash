# Neon PostgreSQL
# Pooled connection (hostname contains "-pooler") — used by the app at runtime
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/devstash?sslmode=require"
# Direct connection (no "-pooler") — used by Prisma CLI for migrations
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/devstash?sslmode=require"
# NextAuth v5 — generate a secret with: npx auth secret
AUTH_SECRET=""
# GitHub OAuth app; callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
# Resend email service; sign up at https://resend.com
RESEND_API_KEY=""
# Verification email sender. Must be on a domain verified in Resend — without
# one, only "onboarding@resend.dev" works and it can only deliver to the
# Resend account owner's own address.
EMAIL_FROM="DevStash <onboarding@resend.dev>"
# Absolute base URL used to build links that leave the app (verification email)
APP_URL="http://localhost:3000"
